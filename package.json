{
  "name": "chronicler-engine",
  "version": "0.1.0",
  "description": "Plataforma de escrita e RPG narrativo colaborativo com IA (Gemini)",
  "repository": {
    "type": "git",
    "url": "https://github.com/alghostzx/Chronicler-Engine.git"
  },
  "homepage": "https://github.com/alghostzx/Chronicler-Engine#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p client/tsconfig.json --noEmit",
    "fonts": "node scripts/copy-fonts.mjs",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@google/genai": "^2.28.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
